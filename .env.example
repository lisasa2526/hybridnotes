# Copy to `.env` and fill in your own Firebase web app config.
# Firebase console → Project settings → Your apps → Web app.
# These are placeholders only — never commit a real project's values here
# if you plan to restrict them; note that Firebase web apiKeys are
# identifiers, not secrets, but App Check + API restrictions are still
# strongly recommended (see README).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: reCAPTCHA Enterprise site key to enable Firebase App Check.
VITE_FIREBASE_APPCHECK_SITE_KEY=
